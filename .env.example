# Backend
PORT=4100
DATA_FILE=./data/sentinel-store.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_ai

# AI providers. Add only the providers you want to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VIDEO_MODEL=gemini-1.5-pro
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Web search. SERPER_API_KEY gives better Google-style results.
SERPER_API_KEY=
